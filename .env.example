# ===================================================================
# PlantCare Environment Configuration
# ===================================================================
#
# Instructions:
# 1. Copy this file to '.env' in the project root directory:
#      copy .env.example .env     (Windows CMD)
#      cp .env.example .env       (Bash / PowerShell)
#
# 2. Obtain your Gemini API key from Google AI Studio:
#      https://aistudio.google.com/app/apikey
#
# 3. Paste your key below:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model
# Supported choices: gemini-2.5-flash (recommended), gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
